{
  "name": "hunk-opencode",
  "version": "0.1.0",
  "description": "Ask OpenCode questions about the current line from Hunk",
  "type": "module",
  "license": "MIT",
  "hunk": {
    "apiVersion": 16,
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun build src/index.tsx --outdir dist --target bun --external react --external @opentui/core --external @opentui/react --external hunkdiff",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/client": "^2.0.3"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@pierre/diffs": "1.3.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "hunkdiff": "0.21.1",
    "react": "^19.2.4",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.6",
    "@opentui/react": ">=0.5.6",
    "react": ">=19.2.4"
  }
}
